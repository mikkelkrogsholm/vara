{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vara",
  "version": "1.0.0",
  "identifier": "dk.vara.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Vara",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#F7F4EE",
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; media-src 'self' asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "shortDescription": "Local dictation with app-grouped history",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/da.lproj/InfoPlist.strings": "localizations/da.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "localizations/en.lproj/InfoPlist.strings",
        "Resources/vara": "../../scripts/vara",
        "Resources/CLI.md": "../../CLI.md",
        "Resources/vara-cli-v1": "../../scripts/vara-cli-v1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "notices/",
      "runtime/who/"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
