+fn sync_source_tree(source: &std::path::Path, destination: &std::path::Path) -> std::io::Result<()> {
+    std::fs::create_dir_all(destination)?;
+    for entry in std::fs::read_dir(source)? {
+        let entry = entry?;
+        let path = entry.path();
+        let copied = destination.join(entry.file_name());
+        if entry.file_type()?.is_dir() {
+            sync_source_tree(&path, &copied)?;
+        } else if !copied.exists() || std::fs::read(&path)? != std::fs::read(&copied)? {
+            std::fs::copy(path, copied)?;
+        }
+    }
+    Ok(())
+}
